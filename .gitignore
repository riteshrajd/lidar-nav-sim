# =====================================================
# Unity .gitignore  —  LidarNav / Haptic-Nav-Sim
# =====================================================

# ── Unity Generated Folders ───────────────────────
/Library/
/Temp/
/Obj/
/Build/
/Builds/
/Logs/
/MemoryCaptures/
/UserSettings/

# ── Unity generated project files (IDE re-generates these) ──
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ── VS Code ───────────────────────────────────────
.vscode/

# ── JetBrains Rider ───────────────────────────────
.idea/
*.sln.DotSettings.user

# ── macOS ─────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Large Binary / Third-Party Asset Packages ────
Assets/LeartesStudios/
Assets/LeartesStudios.meta
Assets/LoafbrrAssets/
Assets/LoafbrrAssets.meta
Assets/TextMesh Pro/
Assets/TextMesh Pro.meta
Assets/AI Navigation/
Assets/AI Navigation.meta
*.navmesh
*.bnm

# ── Build Artifacts ───────────────────────────────
[Bb]uild/
[Bb]uilds/
ExportedObj/
*.apk
*.aab

# ── Python Backend ────────────────────────────────
Python-Server/venv/
Python-Server/**/__pycache__/
Python-Server/**/*.pyc
Python-Server/**/*.pyo
Python-Server/.env

# ── ML model weights (large binaries) ─────────────
*.pt
*.bin
*.gguf
*.safetensors

# ── PDFs / personal files ─────────────────────────
*.pdf

# ── Python media outputs (large image files) ──────
Python-Server/media/input/raw/
Python-Server/media/input/grid/
Python-Server/media/output/
Python-Server/src/pipeline/media/input/raw/
Python-Server/src/pipeline/media/input/grid/
Python-Server/src/pipeline/media/output/

# ── What IS committed (intentionally kept) ────────
# Assets/Scripts/         ← custom C# code
# Assets/PathFinder.cs    ← root-level scripts
# Assets/OccupancyGrid.cs
# Assets/PlayerMovement.cs
# Assets/Scenes/          ← scene files
# Assets/Shaders/         ← custom shaders
# Assets/Prefabs/         ← prefabs
# Assets/Materials/
# Assets/Settings/        ← URP/project settings
# ProjectSettings/        ← Unity project config
# Packages/manifest.json  ← package dependencies
# Python-Server/src/      ← pipeline source code
# docs/                   ← documentation
